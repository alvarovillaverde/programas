package dos;

public class propuesto3 {

	    // Atributo
	    private int numero;

	    // Constructor por defecto: inicializa a 0
	    public propuesto3() {
	        this.numero = 0;
	    }

	    // Constructor que inicializa el número interno
	    public propuesto3(int numero) {
	        this.numero = numero;
	    }

	    // Constructor de copia
	    public propuesto3(propuesto3 otro) {
	        this.numero = otro.numero;
	        System.out.println("Se ha creado una copia del número: " + otro.numero);
	    }

	    // Método que suma un número al valor interno
	    public void sumar(int n) {
	        this.numero += n;
	    }

	    // Método que resta un número al valor interno
	    public void restar(int n) {
	        this.numero -= n;
	    }

	    // Devuelve el valor interno
	    public int getValor() {
	        return this.numero;
	    }

	    // Devuelve el doble del valor interno
	    public int getDoble() {
	        return this.numero * 2;
	    }

	    // Devuelve el triple del valor interno
	    public int getTriple() {
	        return this.numero * 3;
	    }

	    // Permite establecer un nuevo valor
	    public void setNumero(int numero) {
	        this.numero = numero;
	    }

	    // toString
	    @Override
	    public String toString() {
	        return "MiNumero [numero=" + numero + "]";
	    }

	    // equals
	    @Override
	    public boolean equals(Object obj) {
	        if (this == obj) return true;
	        if (obj == null || getClass() != obj.getClass()) return false;
	        propuesto3 otro = (propuesto3) obj;
	        return this.numero == otro.numero;
	    }
	}

}
