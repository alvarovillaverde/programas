package dos;

public class propuesto3 {

	int num;
	
	//constructor por defecto
	propuesto3(int n) {
		this.num = n;
		n = 0;
	}
	//constructor que inicializa el numero interno
	propuesto3(propuesto3 obj) {
		this.num = obj.num;
		System.out.println("hemos creado una copia de: " + obj.toString());
	}
	
	public int getNum() {
		return this.num;
	}

	public void setNum(int n) {
		this.num = n;
	}

	public int aniade() {
		return 1 + this.num;
	}
	
	public int calcularDoble() {
		return 2 * this.num;
	}

	public int calcularTriple() {
		return 3 * this.num;
	}
}
